---
import { services } from '../data/services';
---
<section class="services" id="services" data-stage="3">
  <div class="top">
    <h2>What I build</h2>
    <p>Development leads, design runs through all of it. For bigger projects I bring in the right people.</p>
  </div>
  {services.map((s, q) => (
    <div class="row" tabindex="0" data-q={q}>
      <div class="svc-slot brk"><i></i><i></i><i></i><i></i></div>
      <h3>{s.title}</h3>
      <p>{s.description}</p>
    </div>
  ))}
</section>
