<!-- Dev only: shows the R state, toggles Glyph/Pixels (G) and the layout grid (L). Styles: styles/components/_dev-hud.css -->
<div class="c-dev-hud" aria-live="polite">
  <button type="button" id="mode" class="c-dev-hud__button">Glyph</button>
  <button type="button" id="grid-toggle" class="c-dev-hud__button is-off">Grid</button>
  R state: <b class="c-dev-hud__state" id="hud-name">Pixel</b>
  <div class="c-dev-hud__bar"><i class="c-dev-hud__bar-fill" id="hud-bar"></i></div>
</div>
