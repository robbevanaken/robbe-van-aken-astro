---
// Site header. Styles: styles/components/_site-header.css + _button-menu.css, behaviour: scripts/global/siteHeader.js
// withR: subpages show the animated R centred in the header (it is the only R stage there).
import Socials from '../ui/Socials.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import { nav } from '../../data/site';
interface Props { withR?: boolean }
const { withR = false } = Astro.props;
---
<header class="c-site-header" data-site-header>
  <div class="c-site-header__body o-container o-grid">
    <a class="c-site-header__brand u-text-ui" href="/" data-text-hover><span class="c-site-header__name">{nav.name}</span><span class="c-site-header__role">{nav.role}</span></a>
    {withR && <a class="c-site-header__r" href="/" aria-label="Home" data-stage="2"><span class="c-site-header__r-anchor" id="a-craft"></span></a>}
    <div class="c-site-header__end">
      <nav class="c-site-header__nav u-text-ui" aria-label="Main">
        <ul class="c-site-header__nav-list">
          {nav.links.map((l) => <li class="c-site-header__nav-item"><a class="c-site-header__nav-link" href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <ThemeToggle class="c-site-header__theme" />
      <button class="c-button-menu c-site-header__toggle u-text-ui" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span class="c-button-menu__label"><span class="c-button-menu__text c-button-menu__open">Menu</span><span class="c-button-menu__text c-button-menu__close">Close</span></span>
        <span class="c-button-menu__lines" aria-hidden="true"><i class="c-button-menu__line"></i><i class="c-button-menu__line"></i></span>
      </button>
    </div>
  </div>
  <div class="c-site-header__menu o-container o-grid" id="site-menu" hidden data-menu>
    <ul class="c-site-header__menu-list">
      {nav.links.map((l, i) => <li class="c-site-header__menu-item" style={`--i:${i}`}><a class="c-site-header__menu-link u-text-display" href={l.href}><span class="c-site-header__menu-label">{l.label}</span></a></li>)}
    </ul>
    <Socials class="c-site-header__menu-socials" />
  </div>
</header>
