---
// Page loader: the four corner brackets (as on the buttons and the featured projects) close in from the screen corners
// around the name while the counter runs to 100, then open out again. Page swaps are a plain fade (no overlay).
// Styles: styles/components/_transition.css, behaviour: scripts/global/pageTransitions.js.
import Corners from '../ui/Corners.astro';
import { nav } from '../../data/site';
// one span per letter, so the name can be spelled out
const letters = (text: string) => [...text].map((c) => (c === ' ' ? ' ' : c));
---
<div class="c-transition" aria-hidden="true" data-transition>
  <div class="c-transition__bg" data-transition-bg></div>
  <div class="c-transition__frame" data-transition-frame><Corners /></div>
  <div class="c-transition__loader" data-loader>
    <p class="c-transition__line u-text-ui">{letters(nav.name).map((c) => <span class="c-transition__char" data-loader-char>{c}</span>)}</p>
    <p class="c-transition__line u-text-ui u-text-muted">{letters(nav.role).map((c) => <span class="c-transition__char" data-loader-char>{c}</span>)}</p>
    <p class="c-transition__meta u-text-label"><span>Loading</span><span class="c-transition__count" data-loader-count>000</span></p>
  </div>
</div>
