<!-- Page loader + page transition veil (glyph dither + the R). Styles: styles/components/_transition.css,
     drawing: scripts/r-journey/veil.js, flow: scripts/global/pageTransitions.js -->
<div class="c-transition" aria-hidden="true" data-transition>
  <canvas class="c-transition__canvas" data-transition-canvas></canvas>
  <div class="c-transition__meta o-container o-grid u-text-label">
    <span class="c-transition__label">Loading</span>
    <span class="c-transition__count" data-transition-count>000</span>
  </div>
</div>
