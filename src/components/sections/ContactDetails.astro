---
// Contact page, left column: the portrait (two columns wide; a quiet placeholder in `npm run dev` until portrait.image is
// set in src/data/pages.ts, e.g. '/portrait.jpg' in public/), email + phone, socials. Below the form on tablet and phones. Styles: styles/components/_contact.css. Copy: contactPage in src/data/pages.ts.
import Socials from '../ui/Socials.astro';
import { contactPage as p } from '../../data/pages';
---
<aside class="c-contact__details" aria-label="Contact details">
  {(p.portrait.image || import.meta.env.DEV) && <figure class="c-contact__portrait">
    {p.portrait.image
      ? <img class="c-contact__portrait-img" src={p.portrait.image} alt={p.portrait.alt} loading="lazy" decoding="async" />
      : <figcaption class="u-text-label">{p.portrait.placeholder}</figcaption>}
  </figure>}
  {p.details.map((group) => (
    <div class="c-contact__group">
      <h2 class="c-contact__group-label u-text-label">{group.label}</h2>
      <ul class="c-contact__list u-text-body-l">
        {group.items.map((item) => <li>{item.href ? <a class="c-contact__link" href={item.href}>{item.text}</a> : item.text}</li>)}
      </ul>
    </div>
  ))}
  <div class="c-contact__group">
    <h2 class="c-contact__group-label u-text-label">{p.socialsLabel}</h2>
    <Socials class="c-contact__socials" />
  </div>
</aside>
