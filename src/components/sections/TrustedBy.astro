---
// Client logos with the corner reveal. Styles: styles/components/_trusted-by.css
import Corners from '../ui/Corners.astro';
import { trustedBy } from '../../data/site';
import { clients } from '../../data/clients';
---
<section class="c-trusted-by o-container o-grid" aria-labelledby="trusted-label">
  <p class="c-trusted-by__label u-text-label" id="trusted-label">{trustedBy.label}</p>
  <ul class="c-trusted-by__list" data-reveal>
    {clients.map((c, i) => {
      const Tag = c.url ? 'a' : 'div';
      return (
        <li class="c-trusted-by__item" style={`--i:${i};--w:${c.width}`}>
          <Tag class="c-trusted-by__cell" href={c.url} target={c.url ? '_blank' : undefined} rel={c.url ? 'noopener' : undefined}>
            <Corners />
            <img class="c-trusted-by__logo" src={c.logo} alt={c.name} loading="lazy" />
          </Tag>
        </li>
      );
    })}
  </ul>
</section>
