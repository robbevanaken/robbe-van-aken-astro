---
import Corners from '../ui/Corners.astro';
import { trustedBy } from '../../data/site';
import { clients } from '../../data/clients';
---
<section class="trusted grid" aria-labelledby="trusted-label">
  <p class="label t-label" id="trusted-label">{trustedBy.label}</p>
  <!-- Reveal: the corners start around the logo and move apart to the cell edges, then the logo fades in -->
  <ul class="logos" data-reveal>
    {clients.map((c, i) => {
      const Tag = c.url ? 'a' : 'div';
      return (
        <li style={`--i:${i};--w:${c.width}`}>
          <Tag class="cell" href={c.url} target={c.url ? '_blank' : undefined} rel={c.url ? 'noopener' : undefined}>
            <Corners />
            <img src={c.logo} alt={c.name} loading="lazy" />
          </Tag>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .trusted{padding-top:var(--space-section)}
  .label{text-align:center;color:var(--muted);margin-bottom:var(--space-l)}
  /* four cells of 3 columns each */
  .logos{display:grid;grid-template-columns:subgrid;row-gap:var(--gutter)}
  li{grid-column:span 3}
  .cell{
    position:relative;display:grid;place-items:center;height:clamp(110px,11.1111vw,200px);text-decoration:none;
    container-type:size;
    --corner-dur:1.1s;--corner-delay:calc(var(--i) * .12s);
    --pull-x:34cqw;--pull-y:26cqh;--corner-opacity:0;
  }
  /* logo width is its Figma width @1440, scaled with the viewport */
  img{width:clamp(calc(var(--w) * .72px),calc(var(--w) * 100vw / 1440),calc(var(--w) * 1.3px));height:auto;
    opacity:0;filter:blur(8px);transform:scale(.94);
    transition:opacity .9s var(--ease-out),filter .9s var(--ease-out),transform 1.1s var(--ease-out);
    transition-delay:calc(var(--i) * .12s + .35s)}
  .is-in .cell{--pull-x:0px;--pull-y:0px;--corner-opacity:1}
  .is-in img{opacity:1;filter:none;transform:none}

  @media (max-width:639px){
    li{grid-column:span 2}
    .cell{height:120px}
  }
</style>
