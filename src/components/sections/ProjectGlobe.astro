---
// The projects spread left and right down the page, bent over a globe as they pass, with the corner brackets on the
// one nearest the middle of the screen (home: the featured ones, /work: all of them). Every card links to its project;
// the images are square. layout "spread" (home): alternately right/left, one row each, with the corner brackets on the
// project in the middle; layout "grid" (/work): two per row (6 columns each), no brackets. Slots: "head" (before the list, e.g. the home's sticky R), "intro" (text on the grid's first
// row, next to the first project, which starts on the right) and the default slot (after the list, e.g. a button).
// Styles: styles/components/_featured-projects.css, behaviour: scripts/components/featuredProjects.js
import Corners from '../ui/Corners.astro';
import type { Project } from '../../data/projects';
interface Props { projects: Project[]; label: string; layout?: 'spread' | 'grid' }
const { projects, label, layout = 'spread' } = Astro.props;
const spread = layout === 'spread';
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class:list={['c-featured-projects', `c-featured-projects--${layout}`]} aria-label={label} data-featured-projects>
  <slot name="head" />
  {spread && <div class="c-featured-projects__frame" aria-hidden="true" data-fp-frame><Corners /></div>}
  <div class="c-featured-projects__grid o-container o-grid">
    <slot name="intro" />
    <ol class="c-featured-projects__list">
      {projects.map((p, i) => (
        <li class="c-featured-projects__item" style={spread ? `grid-row:${i + 1}` : undefined} data-fp-item>
          <a class="c-featured-projects__card" href={`/work/${p.slug}`} data-fp-card>
            <span class="c-featured-projects__media">
              {p.image
                ? <img class="c-featured-projects__img" src={p.image} alt="" loading="lazy" decoding="async" />
                : <span class="c-featured-projects__img c-featured-projects__placeholder" style={`--a:${p.colors.a};--b:${p.colors.b};--t:${p.colors.t}`}>{p.label}</span>}
            </span>
            <span class="c-featured-projects__caption">
              <span class="c-featured-projects__caption-title u-text-body-l">{pad(i + 1)} — {p.title}</span>
              <span class="c-featured-projects__caption-text u-text-ui">{p.description}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
  <slot />
</section>
