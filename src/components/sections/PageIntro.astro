---
// Top of a subpage: label, title and intro. Styles: styles/components/_page-intro.css
import Icon from '../ui/Icon.astro';
interface Props { label: string; title: string; intro?: string }
const { label, title, intro } = Astro.props;
---
<header class="c-page-intro o-container o-grid" data-page-intro>
  <p class="c-page-intro__label u-text-label"><Icon name="arrow" class="c-page-intro__arrow" /><span data-page-intro-label>{label}</span></p>
  <h1 class="c-page-intro__title u-text-display" data-page-intro-title>{title}</h1>
  {intro && <p class="c-page-intro__text u-text-body-l" data-page-intro-text>{intro}</p>}
  <slot />
</header>
