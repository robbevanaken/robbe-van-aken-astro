---
// Top of a subpage: label, title and intro (label and intro optional; extra content in the slot).
// Styles: styles/components/_page-intro.css. modifier: e.g. "project" (project detail: title + service).
import Icon from '../ui/Icon.astro';
interface Props { label?: string; title: string; intro?: string; modifier?: string; style?: string }
const { label, title, intro, modifier, style } = Astro.props;
---
<header class:list={['c-page-intro o-container o-grid', modifier && `c-page-intro--${modifier}`]} style={style} data-page-intro>
  {label && <p class="c-page-intro__label u-text-label"><Icon name="arrow" class="c-page-intro__arrow" /><span data-page-intro-label>{label}</span></p>}
  <h1 class="c-page-intro__title u-text-display" data-page-intro-title>{title}</h1>
  {intro && <p class="c-page-intro__text u-text-body-l" data-page-intro-text>{intro}</p>}
  <slot />
</header>
