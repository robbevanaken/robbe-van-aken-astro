---
// The case study on a project's detail page, below its visual (the context itself opens the page: pages/work/[slug].astro).
// ONE CALM RHYTHM (Oct 2026, "too chaotic": five kinds of block, grey panels everywhere, the name three times, the
// facts twice): every text row is a small label on the left (cols 1–3) and its content in one column (cols 5–10),
// between thin lines; every image sits on the same field, a gutter apart.
// 1. the facts as ONE bar between lines (mono labels over the values: client, year, services, built with, the
//    measured result or the collaboration; "Visit site" at its end) — was a row of four panel cards plus the same facts
//    again as rows in the story; then the home's type band (CraftBand) with the project's name (kept on purpose);
// 2. the story as text rows: the challenge, the approach, the parts of a suite, the brand — was a column beside a
//    sticky panel with a phone;
// 3. the work: the device mockup full width, then two equal tiles — the home page scrolling in its window and another
//    page on a phone (Toran: its photos);
// 4. the result: its label and the closing statement in the same columns, the back button under it.
// The next project's visual (ScrollNext) follows straight after.
// Scroll motion: components/caseMotion.js (the window, reduced motion: none). Media open from their centre
// ([data-reveal="media"], global/reveal.js). Copy: src/data/projects.ts, labels in projectPage (src/data/pages.ts).
// Styles: styles/components/_project-case.css
import ProjectImage from '../ui/ProjectImage.astro';
import CraftBand from './CraftBand.astro';
import Icon from '../ui/Icon.astro';
import { getImage } from 'astro:assets';
import type { Project } from '../../data/projects';
import { projectPage } from '../../data/pages';
interface Props { project: Project }
const { project: p } = Astro.props;
const s = p.story, sc = p.screens, ph = p.photos, l = projectPage;
const pad = (n: number) => String(n).padStart(2, '0');

// the fact cards: a label, the value big, a quiet line under it — never an invented number
const cards = [
  p.client && { label: l.facts.client, value: p.client, note: p.service },
  { label: 'Year', value: String(p.year), note: p.status ?? 'Live' },
  p.stack?.length && { label: l.facts.stack, value: p.stack[0], note: p.stack.slice(1).join(', ') || ' ' },
  p.outcome ? { label: 'Result', value: p.outcome.value, note: p.outcome.label }
    : p.parts?.length ? { label: l.story.parts, value: pad(p.parts.length), note: p.parts.map((x) => x.title).join(', ') }
    : p.credit ? { label: p.credit.label, value: p.credit.value, note: ' ' } : null,
].filter(Boolean) as { label: string; value: string; note: string }[];
// the facts at the foot of the story
const facts = [
  { label: l.facts.services, value: p.service },
  p.stack?.length && { label: l.facts.stack, value: p.stack.join(', ') },
  p.credit && p.credit,
  p.status && { label: l.facts.status, value: p.status },
].filter(Boolean) as { label: string; value: string }[];

// the images' sizes on screen
const WIDE = { sizes: '(max-width: 1023px) 92vw, 56vw', widths: [640, 960, 1280, 1600, 2000] };
const NARROW = { sizes: '(max-width: 1023px) 92vw, 40vw', widths: [480, 720, 960, 1280] };
const PHONE = { sizes: '(max-width: 639px) 46vw, 20vw', widths: [360, 540, 720] };
const LONG = { sizes: '(max-width: 1023px) 86vw, 50vw', widths: [720, 1080, 1440, 1920] };
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/**/*.{jpg,jpeg,png,webp}', { eager: true });
const lqip = sc ? (await getImage({ src: files[`/src/assets${sc.desktop}`].default, width: 24, format: 'webp', quality: 40 })).src : '';

---
{s && (
  <section class="c-project-case" aria-label={p.title}>
    <!-- 1. the facts, one bar -->
    <div class="c-project-case__facts-bar o-container o-grid">
      <dl class="c-project-case__facts" style={`--n:${facts.length + (p.url ? 1 : 0)}`}>
        {facts.map((f) => <div class="c-project-case__fact"><dt class="u-text-label u-text-muted">{f.label}</dt><dd>{f.value}</dd></div>)}
        {p.url && <div class="c-project-case__fact c-project-case__fact--link"><dt class="u-text-label u-text-muted">{l.facts.site}</dt><dd><a class="c-project-case__site" href={p.url} target="_blank" rel="noopener"><span class="c-project-case__site-text">{l.facts.visit}</span><span class="c-project-case__site-icon" aria-hidden="true"><Icon name="arrow" class="c-project-case__site-arrow" /><Icon name="arrow" class="c-project-case__site-arrow c-project-case__site-arrow--next" /></span><span class="u-sr-only"> ({p.title}, opens in a new tab)</span></a></dd></div>}
      </dl>
    </div>

    <!-- the home's type band (sections/CraftBand.astro), the project's name running through it -->
    <CraftBand text={`${p.title} ·`} dark={false} class="c-craft-band--case" />

    <!-- 2. the story, text rows -->
    <div class="c-project-case__story o-container o-grid">
      <div class="c-project-case__row" data-reveal><h2 class="c-project-case__label u-text-label u-text-muted">{l.story.challenge}</h2><p class="c-project-case__body">{s.challenge}</p></div>
      <div class="c-project-case__row" data-reveal><h2 class="c-project-case__label u-text-label u-text-muted">{l.story.approach}</h2><p class="c-project-case__body">{s.approach}</p></div>
      {p.parts?.length && (
        <div class="c-project-case__row" data-reveal>
          <h2 class="c-project-case__label u-text-label u-text-muted">{l.story.parts}</h2>
          <ol class="c-project-case__parts" role="list">
            {p.parts.map((part, i) => <li class="c-project-case__part"><span class="u-text-label u-text-muted">{pad(i + 1)}</span><h3 class="c-project-case__part-title">{part.title}</h3><p class="c-project-case__part-text">{part.text}</p></li>)}
          </ol>
        </div>
      )}
      {p.brand && <div class="c-project-case__row" data-reveal><h2 class="c-project-case__label u-text-label u-text-muted">{l.story.brand}</h2><p class="c-project-case__body">{p.brand.text}</p></div>}
    </div>

    <!-- 3. the work: the mockup full width, then two equal tiles -->
    <div class="c-project-case__work o-container o-grid">
      {p.mockup && (
        <div class="c-project-case__tile c-project-case__tile--full" data-reveal="media">
          <ProjectImage class="c-project-case__img" src={p.mockup} alt={`${p.title}: the website on a device`} {...WIDE} />
        </div>
      )}
      {sc && (
        <>
          <div class="c-project-case__tile c-project-case__tile--half c-project-case__tile--field" data-reveal="media">
            <div class="c-project-case__window" style={`--lqip:url(${lqip})`} data-case-scroll><ProjectImage class="c-project-case__long" src={sc.desktop} alt={`${p.title}: the website's home page on a desktop screen`} {...LONG} /></div>
          </div>
          <div class="c-project-case__tile c-project-case__tile--half c-project-case__tile--field" data-reveal="media" style="--i:1">
            <ProjectImage class="c-project-case__phone" src={sc.mobile[1]} alt={`${p.title}: another page on a phone`} {...PHONE} />
          </div>
        </>
      )}
      {!sc && ph && (
        <>
          <div class="c-project-case__tile c-project-case__tile--half" data-reveal="media"><ProjectImage class="c-project-case__img" src={ph[1]} alt="" {...NARROW} /></div>
          <div class="c-project-case__tile c-project-case__tile--half" data-reveal="media" style="--i:1"><ProjectImage class="c-project-case__img" src={ph[2]} alt="" {...NARROW} /></div>
          <div class="c-project-case__tile c-project-case__tile--full" data-reveal="media"><ProjectImage class="c-project-case__img" src={ph[3]} alt="" data-case-parallax {...WIDE} /></div>
        </>
      )}
      {!sc && !ph && [0, 1].map((i) => (
        <div class="c-project-case__tile c-project-case__tile--half c-project-case__tile--empty" style={`--a:${p.colors.a};--b:${p.colors.b};--t:${p.colors.t}`} data-reveal><span class="u-text-label">{l.screens}</span></div>
      ))}
    </div>

    <!-- 4. the result -->
    <div class="c-project-case__close o-container o-grid">
      <span class="c-project-case__label u-text-label u-text-muted">{l.story.result}</span>
      <div class="c-project-case__close-body">
        <p class="c-project-case__statement" data-highlight-text>{s.result}</p>
        <div class="c-project-case__end"><slot name="end" /></div><!-- the page's "All projects" button -->
      </div>
    </div>
  </section>
)}
