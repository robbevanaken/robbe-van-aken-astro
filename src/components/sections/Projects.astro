---
// Featured projects on home as an ACCORDION OF STRIPS (grown from the lab's proposal 4; no pin: the section simply
// scrolls by). The head ("Recent work" + the count), then the projects side by side as tall strips in the pricing
// cards' three tones — paper (ink text), the accent red (light text), the quiet panel (page text, a hairline edge).
// At rest: equal strips, each with its number, service · year and name. Hover / focus (desktop): that strip opens wide,
// the others narrow (their name turns upright), and the project's THUMBNAIL — one screen of the site (`home.jpg` on
// its own light colour; Toran: its mood photo) — trails the cursor in a preview window (Osmo's "Image Preview Cursor
// Follower", components/previewFollower.js: moving to another strip the old image slides out, the new one in), with
// "View project" on it. Touch on a wide screen: the first tap opens,
// the second goes. Below 1024px: rows between thin lines (after bymonolog.com's success stories): the thumbnail on the
// left, "01 / 03", the name, the description and service · year on the right (tried: the accordion turned 90°, one
// band always open — the one open project read oddly). The page's R stays small at the
// top centre (#a-craft + an end marker). Dark chapter (t-dark). components/workStrips.js, _work-strips.css.
// (Tried: a pinned showreel, and this accordion driven by a scroll pin on the projects' own colours — the pin felt
// forced, the colours odd next to the rest of the site.)
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import ProjectImage from '../ui/ProjectImage.astro';
import { work } from '../../data/site';
import { projects, homeShot } from '../../data/projects';
const featured = projects.slice(0, work.featured);
const pad = (n: number) => String(n).padStart(2, '0');
const TONES = ['paper', 'accent', 'panel'];
const SIZES = { sizes: '(max-width: 1023px) 80vw, 30vw', widths: [480, 720, 960, 1280, 1600] };
---
<div class="t-dark">
<section class="c-work-strips" aria-labelledby="work-title" data-strips data-follower-wrap>
  <div class="c-work-strips__head" data-stage="2" aria-hidden="true"><div class="c-work-strips__r" id="a-craft"></div></div>
  <div class="c-work-strips__body o-container o-grid" id="work">
    <div class="c-work-strips__top">
      <h2 class="c-work-strips__title" id="work-title">{work.title}</h2>
      <p class="c-work-strips__count u-text-label" aria-hidden="true">{pad(featured.length)} projects</p>
    </div>
    <ol class="c-work-strips__list" role="list" data-strips-list data-follower-collection>
      {featured.map((p, i) => {
        const shot = homeShot(p.slug);
        return (
          <li class={`c-work-strips__item c-work-strips__item--${TONES[i % TONES.length]}`} data-strip={i} data-follower-item>
            <a class="c-work-strips__link" href={`/work/${p.slug}`} aria-label={`${p.title}: ${p.description}`} data-strip-link>
              <span class="c-work-strips__bar" aria-hidden="true">
                <span class="c-work-strips__num u-text-label">{pad(i + 1)}<span class="c-work-strips__total"> / {pad(featured.length)}</span></span>
                <span class="c-work-strips__meta u-text-label">{p.service} · {p.year}</span>
              </span>
              <span class:list={['c-work-strips__media', { 'c-work-strips__media--photo': !shot }]} aria-hidden="true" style={`--tb:${p.colors.b}`} data-follower-visual>
                {shot
                  ? <ProjectImage class="c-work-strips__shot" src={shot} alt="" {...SIZES} />
                  : <ProjectImage class="c-work-strips__shot c-work-strips__shot--photo" src={p.image!} alt="" position={p.position} {...SIZES} />}
              </span>
              <span class="c-work-strips__upright" aria-hidden="true">{p.title}</span>
              <h3 class="c-work-strips__name">{p.title}<Icon name="arrow" class="c-work-strips__arrow" /></h3>
              <span class="c-work-strips__desc" aria-hidden="true">{p.description}</span>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
  <div class="c-work-strips__end" data-stage="2" aria-hidden="true"></div>
  <div class="c-work-strips__follower" aria-hidden="true" data-follower-cursor>
    <div class="c-work-strips__follower-inner" data-follower-cursor-inner>
      <span class="c-work-strips__follower-label u-text-ui">{work.cursor}</span>
    </div>
  </div>
</section>
<div class="c-featured-projects__foot o-container o-grid"><Button href={work.cta.href} class="c-featured-projects__all">{work.cta.label}</Button></div>
</div>
