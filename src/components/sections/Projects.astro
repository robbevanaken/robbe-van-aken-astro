---
// Featured projects on home: the first `work.featured` projects on the globe (sections/ProjectGlobe.astro), the intro
// text on the left next to the first project.
// The small R stays at the top of the screen while they pass (stage 2 from the sticky head down to the end marker).
// Styles: styles/components/_projects-intro.css + _featured-projects.css
import Button from '../ui/Button.astro';
import ProjectGlobe from './ProjectGlobe.astro';
import { work } from '../../data/site';
import { projects } from '../../data/projects';
---
<ProjectGlobe projects={projects.slice(0, work.featured)} label="Featured projects">
  <div class="c-featured-projects__head" slot="head" data-stage="2"><div class="c-featured-projects__r" id="a-craft"></div></div>
  <div class="c-projects-intro" id="work" slot="intro">
    <h2 class="c-projects-intro__title u-text-h2">{work.title}</h2>
    <p class="c-projects-intro__text u-text-body-l u-text-muted" data-highlight-text>{work.intro}</p>
  </div>
  <div class="c-featured-projects__foot o-container o-grid"><Button href={work.cta.href} class="c-featured-projects__all">{work.cta.label}</Button></div>
  <!-- the R stays in stage 2 down to here -->
  <div class="c-featured-projects__end" data-stage="2" aria-hidden="true"></div>
</ProjectGlobe>
