---
// "Scroll to next project" (based on the Osmo Supply resource, in the site's style): right after the content, the next
// project's visual, two columns narrower than on its own page (the detail page's 16:9), partly below the fold; it rises
// and grows into exactly the box the next page shows it in. Only scrolling opens the next project:
// the link can't be clicked (pointer-events), the script follows it at the end of the scroll.
// Styles: styles/components/_scroll-next.css, behaviour: scripts/components/scrollNext.js. Keep the data- attributes.
import type { Project } from '../../data/projects';
import ProjectVisual from '../ui/ProjectVisual.astro';
// data-next-*: the next project's texts; scrollNext.js measures that page's layout with them
interface Props { project: Project; label: string }
const { project, label } = Astro.props; // label: for the link's accessible name
---
<section data-scroll-next-wrap data-scroll-start="top top" data-scroll-end="bottom bottom" class="c-scroll-next" data-next-title={project.title} data-next-service={project.service} data-next-desc={project.description} data-next-year={project.year}>
  <a data-scroll-next-link href={`/work/${project.slug}`} class="c-scroll-next__inner" aria-label={`${label}: ${project.title}`}>
    <div class="c-scroll-next__stage">
      <!-- where the visual starts, partly below the fold (the box below is laid over it by the script) -->
      <div class="o-container o-grid"><div class="c-scroll-next__slot" data-scroll-next-slot></div></div>
    </div>
    <div class="c-scroll-next__bg" data-scroll-next-box>
      <div class="c-scroll-next__clip">
        {project.shot || project.image
          ? <ProjectVisual project={project} data-scroll-next-bg class="c-scroll-next__bg-img" />
          : <div data-scroll-next-bg class="c-scroll-next__bg-img c-scroll-next__bg-img--placeholder" style={`--a:${project.colors.a};--b:${project.colors.b};--t:${project.colors.t}`}><span class="c-scroll-next__word" data-scroll-next-word>{project.label}</span></div>}
      </div>
      <!-- on the visual, like the project cards' labels: what's coming (top left) and how far the scroll to it is
           (top right: a counter 000–100 and a line, like the page loader's); they fade out just before the end, so the
           visual lands bare, as on the next page -->
      <div class="c-scroll-next__hud" aria-hidden="true" data-scroll-next-hud>
        <span class="c-scroll-next__tag u-text-label"><span class="c-scroll-next__tag-label">{label}</span><span class="c-scroll-next__tag-title">{project.title}</span></span>
        <span class="c-scroll-next__tag c-scroll-next__tag--count u-text-label"><span class="c-scroll-next__count" data-scroll-next-count>000</span><i class="c-scroll-next__line"><i class="c-scroll-next__fill" data-scroll-next-fill></i></i></span>
      </div>
    </div>
  </a>
</section>
