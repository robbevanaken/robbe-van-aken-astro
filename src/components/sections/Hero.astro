---
// Home hero. Styles: styles/components/_hero-home.css
import Button from '../ui/Button.astro';
import { hero } from '../../data/site';
---
<section class="c-hero-home o-container o-grid" data-stage="0">
  <h1 class="c-hero-home__title u-text-display">
    {hero.title.map((l) => <span class:list={['c-hero-home__line', { 'u-text-muted': l.muted }]}>{l.text}</span>)}
  </h1>
  <!-- R anchor: the engine centres the big R on this box -->
  <div class="c-hero-home__r"><div class="c-hero-home__r-anchor" id="a-hero"></div></div>
  <div class="c-hero-home__side">
    <p class="c-hero-home__intro u-text-body-l">{hero.intro}</p>
    <Button href={hero.cta.href}>{hero.cta.label}</Button>
  </div>
</section>
