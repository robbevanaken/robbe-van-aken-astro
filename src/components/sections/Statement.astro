---
// Statement (home, after the services): the story's last word before the footer, a pinned moment (after bymonolog.com's
// gap section). The sticky screen holds the big staggered lines (two-tone like the page's other titles, small muted
// words hung beside them, a funny GIF between them: ui/StatementLoop.astro) while the wrapper scrolls on; the lines
// GIFs open from their centre first (scrubbed), then the words slide up through their line's mask (expo.out, a
// time-based cascade once the pin lands: components/statementPin.js).
// Styles: styles/components/_statement.css. Copy: statement in src/data/site.ts.
import { statement } from '../../data/site';
import Loop from '../ui/StatementLoop.astro';
const text = statement.map((l) => [l.lead, l.big, l.small].filter(Boolean).join(' ')).join(' ');
---
<section class="c-statement t-dark" data-statement-pin>
  <div class="c-statement__sticky o-container o-grid">
  <p class="u-sr-only">{text}</p>
  {statement.map((l, i) => (
    <p class:list={['c-statement__line', `c-statement__line--${i + 1}`]} aria-hidden="true">
      {l.lead && <span class="c-statement__small u-text-body-l u-text-muted">{l.lead}</span>}
      {l.lead && l.gif && <Loop {...l.gif} />}
      <span class:list={['c-statement__big', { 'u-text-muted': l.muted }]}>{l.big}</span>
      {!l.lead && l.gif && <Loop {...l.gif} />}
      {l.small && <span class="c-statement__small u-text-body-l u-text-muted">{l.small}</span>}
    </p>
  ))}
  </div>
</section>
<!-- holds the page's R in the services' state (scrolled away with them) until the statement is past, so it doesn't fly
     through the words on its way to the footer -->
<span class="c-statement__hold" data-stage="3" aria-hidden="true"></span>

