---
// Statement (home, after the services): the story's last word before the footer. After the long held services stage it
// deliberately FLOWS (no pin — two held, sparse screens in a row read as empty): the big staggered lines (two-tone like
// the page's other titles, small muted words hung beside them, a funny GIF between them: ui/StatementLoop.astro) pass
// in about a screen; as the section comes in, the GIFs open from their centre while the words slide up through their
// line's mask (expo.out cascade, components/statementReveal.js), reversed on scrolling back out.
// Styles: styles/components/_statement.css. Copy: statement in src/data/site.ts.
import { statement } from '../../data/site';
import Loop from '../ui/StatementLoop.astro';
const text = statement.map((l) => [l.lead, l.big, l.small].filter(Boolean).join(' ')).join(' ');
---
<section class="c-statement t-dark" data-statement>
  <div class="c-statement__inner o-container o-grid">
  <!-- the page's R, small and central above the lines (as above the projects): a stage-2 marker with its own anchor
       (r-journey/engine.js, data-r-self); it lands here as the statement passes, then jumps on into the footer -->
  <div class="c-statement__r" data-stage="2" data-r-self aria-hidden="true"></div>
  <p class="u-sr-only">{text}</p>
  {statement.map((l, i) => (
    <p class:list={['c-statement__line', `c-statement__line--${i + 1}`]} aria-hidden="true">
      {l.lead && <span class="c-statement__small u-text-body-l u-text-muted">{l.lead}</span>}
      {l.lead && l.gif && <Loop {...l.gif} />}
      <span class:list={['c-statement__big', { 'u-text-muted': l.muted }]}>{l.big}</span>
      {!l.lead && l.gif && <Loop {...l.gif} />}
      {l.small && <span class="c-statement__small u-text-body-l u-text-muted">{l.small}</span>}
    </p>
  ))}
  </div>
</section>
