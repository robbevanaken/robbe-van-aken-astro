---
// Services. Styles: styles/components/_services.css, script: scripts/components/services.js.
// The head (title + intro, centred) scrolls by, then the stage (one screen, stage 3) is pinned while
// [data-services-pin] scrolls on, one screen per service. The R becomes service 0's icon in
// [data-service-slot] and morphs into the next one's on scroll (engine.js); the text in the stage switches along with
// it (halfway through each morph).
import Corners from '../ui/Corners.astro';
import { servicesIntro } from '../../data/site';
import { services } from '../../data/services';
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="c-services t-dark" id="services" data-services style={`--services:${services.length}`}>
  <div class="c-services__head o-container o-grid">
    <!-- the page's R lands here, small and central above the title (a stage-2 marker with its own anchor, data-r-self),
         on its way from the pitch into the first icon — without it the big fragment R flew right over the head -->
    <div class="c-services__r" data-stage="2" data-r-self aria-hidden="true"></div>
    <h2 class="c-services__title u-text-h2">{servicesIntro.title}</h2>
    <p class="c-services__intro u-text-body-l u-text-muted" data-highlight-text>{servicesIntro.text}</p>
  </div>
  <div class="c-services__pin" data-services-pin>
    <div class="c-services__stage o-container o-grid" data-stage="3">
      <div class="c-services__slot" data-service-slot><Corners /></div>
      <ol class="c-services__list">
        {services.map((s, i) => (
          <li class:list={['c-services__item', { 'is-active': i === 0 }]} data-service={i}>
            <p class="c-services__count u-text-label u-text-muted"><span class="u-sr-only">{pad(i + 1)}</span><span class="c-services__roll" aria-hidden="true"><span class="c-services__roll-list">{services.map((_, j) => <span>{pad(j + 1)}</span>)}</span></span> / {pad(services.length)}</p>
            <h3 class="c-services__name u-text-h2">{s.title}</h3>
            <p class="c-services__text u-text-body-l u-text-muted">{s.description}</p>
          </li>
        ))}
      </ol>
      <!-- one segment per service, filled as the services pass; only shown while the stage is pinned (components/services.js) -->
      <div class="c-services__progress is-hidden" aria-hidden="true" data-services-progress>{services.map(() => <i class="c-services__bar" data-services-bar></i>)}</div>
    </div>
  </div>
</section>
