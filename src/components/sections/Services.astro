---
// Services (home, between the pitch and the projects; the dark chapter, t-dark). Styles: styles/components/_services.css,
// script: scripts/components/services.js. One pinned screen per service ([data-services-pin]): the head on top (title +
// intro, in the pitch's columns), then — desktop — the four services as panels side by side (after a staircase of
// process steps seen on neutomni.com, in this site's language): as the pin runs, their tops step down from left to
// right into a staircase (--p, the progress 0 → 1), the active one turns to the accent, and the R, becoming each
// service's icon and morphing from icon to icon (engine.js, [data-service-slot]), moves along to the active panel
// (--sv, the service progress 0 … n-1). Below 1024px: one centred column, the item switching per service.
import Corners from '../ui/Corners.astro';
import { servicesIntro } from '../../data/site';
import { services } from '../../data/services';
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="c-services t-dark" id="services" data-services style={`--services:${services.length}`}>
  <div class="c-services__pin" data-services-pin>
    <div class="c-services__stage o-container o-grid" data-stage="3">
      <h2 class="c-services__title u-text-h2">{servicesIntro.title}</h2>
      <p class="c-services__intro u-text-body-l" data-highlight-text>{servicesIntro.text}</p>
      <div class="c-services__slot" data-service-slot><Corners /></div>
      <ol class="c-services__list">
        {services.map((s, i) => (
          <li class:list={['c-services__item', { 'is-active': i === 0 }]} data-service={i} style={`--i:${i}`}>
            <p class="c-services__count u-text-label u-text-muted"><span class="c-services__num">{pad(i + 1)}</span><span class="c-services__roll" aria-hidden="true"><span class="c-services__roll-list">{services.map((_, j) => <span>{pad(j + 1)}</span>)}</span></span> / {pad(services.length)}</p>
            <h3 class="c-services__name u-text-h2">{s.title}</h3>
            <p class="c-services__text u-text-body-l u-text-muted">{s.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
