---
// Services. Styles: styles/components/_services.css. The engine rebuilds quarter i of the R in [data-service-slot] i.
import Corners from '../ui/Corners.astro';
import { servicesIntro } from '../../data/site';
import { services } from '../../data/services';
---
<section class="c-services o-container o-grid" id="services" data-stage="3">
  <h2 class="c-services__title u-text-h2">{servicesIntro.title}</h2>
  <p class="c-services__intro u-text-body-l u-text-muted" data-highlight-text>{servicesIntro.text}</p>
  <ul class="c-services__list">
    {services.map((s, q) => (
      <li class="c-services__row" tabindex="0" data-service={q}>
        <div class="c-services__slot" data-service-slot><Corners /></div>
        <h3 class="c-services__name u-text-lead">{s.title}</h3>
        <p class="c-services__text u-text-body-l u-text-muted" data-highlight-text>{s.description}</p>
      </li>
    ))}
  </ul>
</section>
