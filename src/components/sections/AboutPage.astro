---
// About: one statement, then quiet text. A big two-part title (the first part muted) as the page's one typographic
// moment, the lead below it, the R beside them. Then a spec sheet: the portrait on the left (sticky, with a caption), and
// How I build, Stack and Ship on the right, each a title over rows between thin lines (a row: title left, text right).
// The page's one R (Page journey) starts right of the title and lead (stage 0, the 3D R that turns with the mouse;
// phones: centred below the lead), scrolls away with it and only past the sheet flies into the footer.
// Styles: styles/components/_about.css. Copy: aboutPage in src/data/pages.ts.
import { aboutPage as p } from '../../data/pages';
---
<article class="c-about o-container o-grid">
  <h1 class="c-about__title">{p.heading.map((t) => <span class:list={{ 'u-text-muted': t.muted }}>{t.text}</span>)}</h1>
  <p class="c-about__lead u-text-body-l u-text-muted">{p.lead}</p>
  <!-- the R's first spot: right of the title and lead -->
  <div class="c-about__hero-r" data-stage="0" aria-hidden="true"><span class="c-about__hero-r-anchor" id="a-hero"></span></div>

  <div class="c-about__sheet">
    <aside class="c-about__aside">
      <figure class="c-about__portrait">
        {p.portrait.image
          ? <img class="c-about__portrait-img" src={p.portrait.image} alt={p.portrait.alt} loading="lazy" decoding="async" />
          : <span class="c-about__portrait-placeholder u-text-label">{p.portrait.placeholder}</span>}
      </figure>
      <p class="c-about__caption u-text-ui"><span>{p.portrait.caption[0]}</span><span class="u-text-muted">{p.portrait.caption[1]}</span></p>
    </aside>
    <div class="c-about__main">
      {p.sections.map((s) => (
        <section class="c-about__section">
          <h2 class="c-about__section-title u-text-lead">{s.label}</h2>
          <dl class="c-about__rows">
            {s.items?.map((it) => <div class="c-about__row"><dt class="c-about__row-title u-text-ui">{it.title}</dt><dd class="c-about__row-text u-text-ui">{it.text}</dd></div>)}
            {s.groups?.map((g) => <div class="c-about__row"><dt class="c-about__row-title u-text-ui">{g.label}</dt><dd class="c-about__row-text u-text-ui">{g.items.join(', ')}</dd></div>)}
          </dl>
        </section>
      ))}
    </div>
  </div>
  <!-- an end marker (stage 0 again): until here the R stays beside the title (scrolled away with it), only then it flies into the footer -->
  <div class="c-about__end" data-stage="0" aria-hidden="true"></div>
</article>
