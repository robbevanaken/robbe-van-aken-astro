---
// Line icons, drawn with currentColor. Size them from the parent. Styles: styles/components/_icon.css
interface Props { name: 'arrow' | 'globe' | 'together'; class?: string }
const { name, class: cls } = Astro.props;
const box = name === 'arrow' ? '0 0 24 20' : '0 0 23 23';
---
<svg class:list={['c-icon', `c-icon--${name}`, cls]} viewBox={box} fill="none" aria-hidden="true">
  {name === 'arrow' && <path fill="currentColor" d="M13.8393 0L24 10L13.8393 20H9.71009V17.7778H12.8054L19.5792 11.1111H0V8.88889H19.5792L12.8054 2.22222H9.71009V0H13.8393Z" />}
  {name === 'globe' && <g stroke="currentColor">
    <path d="M11.5003 21.0834C16.793 21.0834 21.0837 16.7927 21.0837 11.5001C21.0837 6.20735 16.793 1.91675 11.5003 1.91675C6.2076 1.91675 1.91699 6.20735 1.91699 11.5001C1.91699 16.7927 6.2076 21.0834 11.5003 21.0834Z" />
    <path d="M11.5003 21.0834C13.6174 21.0834 15.3337 16.7927 15.3337 11.5001C15.3337 6.20735 13.6174 1.91675 11.5003 1.91675C9.38324 1.91675 7.66699 6.20735 7.66699 11.5001C7.66699 16.7927 9.38324 21.0834 11.5003 21.0834Z" />
    <path d="M1.91699 11.5H21.0837" />
    <path d="M19.1673 17.2502C16.743 16.2315 14.1294 15.7414 11.5006 15.8127C8.87196 15.7414 6.25829 16.2315 3.83398 17.2502" />
    <path d="M3.83398 5.75C6.25829 6.76873 8.87196 7.25879 11.5006 7.1875C14.1294 7.25879 16.743 6.76873 19.1673 5.75" />
  </g>}
  {name === 'together' && <g stroke="currentColor">
    <circle cx="8.25" cy="11.5" r="6.25" />
    <circle cx="14.75" cy="11.5" r="6.25" />
  </g>}
</svg>
