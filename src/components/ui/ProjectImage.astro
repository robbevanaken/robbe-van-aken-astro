---
// A project's visual, optimised at build time: one WebP at the source's size, width / height set (no layout shift).
// One file per project, the same URL on its card, its detail page and the scroll-next section, so the card → page
// and next-project transitions hand over to an image that's already loaded (a srcset per place would pick different
// files and flash). A plain <img>, as before: classes and data- attributes go on it.
// `src` is the path from src/data/projects.ts ('/projects/x.jpg'); the file lives in src/assets/projects/.
// `eager`: above the fold (the project page's visual, the first card on /work: their LCP).
import { Image } from 'astro:assets';
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*.{jpg,jpeg,png,webp}', { eager: true });
interface Props { src: string; alt?: string; eager?: boolean; class?: string; [attr: string]: unknown }
const { src, alt = '', eager = false, class: cls, ...rest } = Astro.props;
const file = files[`/src/assets${src}`]?.default;
if (!file) throw new Error(`ProjectImage: no file for ${src} in src/assets/projects/`);
---
<Image src={file} alt={alt} format="webp" quality={82} class={cls} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" {...rest} />
