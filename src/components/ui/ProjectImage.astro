---
// A project image, optimised at build time: a <picture> with AVIF + WebP in several widths and a JPEG fallback,
// width / height set (no layout shift). `src` is the path from src/data/projects.ts ('/projects/x.jpg',
// '/projects/<slug>/desktop-1.jpg'); the files live in src/assets/projects/.
// The project's main visual (its card, its detail page, the scroll-next section) always uses the default `sizes`
// and `widths`: `sizes` is read against the screen, not the box, so the browser picks the same file in all three
// places, and the open-project and next-project transitions hand over to an image that's already loaded.
// `sizes` / `widths`: only for other images (the case study's screenshots). `eager`: above the fold (its LCP).
// `position`: the crop's focus (object-position), e.g. '50% 40%'.
// The <picture> is display: contents, so the <img> is laid out as before (classes and data- attributes go on it).
import { Picture } from 'astro:assets';
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/**/*.{jpg,jpeg,png,webp}', { eager: true });
export const MAIN_SIZES = '92vw';
export const MAIN_WIDTHS = [640, 960, 1280, 1600, 2000, 2560, 3200];
interface Props { src: string; alt?: string; eager?: boolean; class?: string; sizes?: string; widths?: number[]; position?: string; [attr: string]: unknown }
const { src, alt = '', eager = false, class: cls, sizes = MAIN_SIZES, widths = MAIN_WIDTHS, position, ...rest } = Astro.props;
const file = files[`/src/assets${src}`]?.default;
if (!file) throw new Error(`ProjectImage: no file for ${src} in src/assets/projects/`);
const w = widths.filter((x) => x < file.width);
if (!w.length || w[w.length - 1] < file.width) w.push(file.width); // up to the source's own width
---
<Picture src={file} alt={alt} formats={['avif', 'webp']} fallbackFormat="jpg" quality={70} widths={w} sizes={sizes}
  class={cls} style={position ? `object-position:${position}` : undefined} loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined} decoding="async" pictureAttributes={{ style: 'display:contents' }} {...rest} />
