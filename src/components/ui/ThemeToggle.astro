---
// Light/dark toggle: a disc, half filled, that turns half a turn when the theme changes. Delegated click in
// scripts/global/theme.js ([data-theme-toggle]); the screen reader label follows the theme in CSS.
// Styles: styles/components/_theme-toggle.css
import { nav } from '../../data/site';
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<button class:list={['c-theme-toggle', cls]} type="button" data-theme-toggle>
  <span class="c-theme-toggle__disc" aria-hidden="true"></span>
  <span class="c-theme-toggle__label c-theme-toggle__label--light u-sr-only">{nav.theme.toLight}</span>
  <span class="c-theme-toggle__label c-theme-toggle__label--dark u-sr-only">{nav.theme.toDark}</span>
</button>
