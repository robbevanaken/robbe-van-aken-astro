---
// Light/dark toggle, two forms (delegated click in scripts/global/theme.js: [data-theme-toggle]):
// - default: a quiet text button worded for what a click does ("Dark mode" / "Light mode"), for a text context
//   (not in use now);
// - `float`: a small square with one half filled, fixed bottom right inside the grid (where the loader's counter sits),
//   on every page and every screen; it turns half a turn on the switch, so the filled half swaps sides. Out of the way during the
//   loader, page swaps and with the menu open. The screen reader label says what a click does.
// Styles: styles/components/_theme-toggle.css
import { nav } from '../../data/site';
interface Props { class?: string; float?: boolean }
const { class: cls, float = false } = Astro.props;
---
{float
  ? <button class:list={['c-theme-toggle c-theme-toggle--float', cls]} type="button" data-theme-toggle>
      <span class="c-theme-toggle__square" aria-hidden="true"></span>
      <!-- the label, as a tooltip on hover / keyboard focus (and for screen readers): what a click does -->
      <span class="c-theme-toggle__tip u-text-label">
        <span class="c-theme-toggle__label c-theme-toggle__label--to-dark">{nav.theme.dark}</span>
        <span class="c-theme-toggle__label c-theme-toggle__label--to-light">{nav.theme.light}</span>
        <span class="c-theme-toggle__label c-theme-toggle__label--back">{nav.theme.back}</span>
      </span>
    </button>
  : <button class:list={['c-theme-toggle', cls]} type="button" data-theme-toggle>
      <span class="c-theme-toggle__label c-theme-toggle__label--to-dark">{nav.theme.dark}</span>
      <span class="c-theme-toggle__label c-theme-toggle__label--to-light">{nav.theme.light}</span>
      <span class="c-theme-toggle__label c-theme-toggle__label--back">{nav.theme.back}</span>
    </button>}
