---
// Button with the brand arrow. Styles: styles/components/_button.css
import Icon from './Icon.astro';
import Corners from './Corners.astro';
interface Props { href: string; class?: string }
const { href, class: cls } = Astro.props;
---
<a class:list={['c-button u-text-ui', cls]} href={href}>
  <Corners />
  <span class="c-button__label"><span class="c-button__text"><slot /></span></span>
  <span class="c-button__icon"><Icon name="arrow" /></span>
</a>
