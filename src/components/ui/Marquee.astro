---
// The accent band (red, light text), in the site's own type: sentence case, the ui size a step up, the line's parts
// separated by a middle dot as in the type band (tried: small uppercase with letter spacing and an icon — a globe, two
// circles — between the parts: it read as a stock ticker beside the rest). Styles: styles/components/_marquee.css,
// motion: scripts/components/marquee.js
// fill: starts white and fills with the accent from the left, driven by a script through [data-marquee-fill] (scroll next).
import { marquee } from '../../data/site';
interface Props { text?: string; fill?: boolean }
const { text = marquee.text, fill = false } = Astro.props;
const items = Array.from({ length: 12 });
---
<div class:list={['c-marquee', { 'c-marquee--fill': fill }]} role="note" aria-label={text} data-marquee>
  {fill && <span class="c-marquee__fill" data-marquee-fill></span>}
  <div class="c-marquee__track" aria-hidden="true" data-marquee-track>
    {items.map(() => <span class="c-marquee__item">{text}<span class="c-marquee__sep">·</span></span>)}
  </div>
</div>
