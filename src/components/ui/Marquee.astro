---
// Orange banner. Styles: styles/components/_marquee.css, motion: scripts/components/marquee.js
import Icon from './Icon.astro';
import { marquee } from '../../data/site';
interface Props { text?: string }
const { text = marquee.text } = Astro.props;
const items = Array.from({ length: 12 });
---
<div class="c-marquee" role="note" aria-label={text} data-marquee>
  <div class="c-marquee__track" aria-hidden="true" data-marquee-track>
    {items.map(() => <span class="c-marquee__item">{text}<Icon name="globe" /></span>)}
  </div>
</div>
