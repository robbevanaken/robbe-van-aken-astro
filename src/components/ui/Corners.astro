---
// Four corner brackets around the parent (the parent needs position:relative).
// Driven by CSS variables set on any ancestor, so parents can animate them:
//   --corner-offset  push the whole frame outwards (default 0 = on the edge)
//   --pull-x/--pull-y  move each bracket towards the centre (positive) or outwards (negative)
//   --corner-opacity, --corner-color, --corner-size, --corner-delay, --corner-dur, --corner-ease
---
<span class="corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>

<style>
  .corners{position:absolute;inset:calc(-1 * var(--corner-offset,0px));pointer-events:none}
  i{
    --px:var(--pull-x,0px);--py:var(--pull-y,0px);
    position:absolute;width:var(--corner-size,14px);height:var(--corner-size,14px);
    border:0 solid var(--corner-color,var(--line-strong));
    opacity:var(--corner-opacity,1);
    transition:transform var(--corner-dur,.9s) var(--corner-ease,var(--ease-out)),opacity var(--corner-dur,.9s) var(--corner-ease,var(--ease-out)),border-color .3s;
    transition-delay:var(--corner-delay,0s);
  }
  i:nth-child(1){top:0;left:0;border-top-width:1px;border-left-width:1px;transform:translate(var(--px),var(--py))}
  i:nth-child(2){top:0;right:0;border-top-width:1px;border-right-width:1px;transform:translate(calc(-1 * var(--px)),var(--py))}
  i:nth-child(3){bottom:0;left:0;border-bottom-width:1px;border-left-width:1px;transform:translate(var(--px),calc(-1 * var(--py)))}
  i:nth-child(4){bottom:0;right:0;border-bottom-width:1px;border-right-width:1px;transform:translate(calc(-1 * var(--px)),calc(-1 * var(--py)))}
</style>
