---
// HTML shell for every page: styles, font preloads and the single script entry (scripts/main.js).
import '../styles/main.css';
import { meta, nav, socials, pageTheme } from '../data/site';
import Music from '../components/ui/Music.astro';
import SoundToggle from '../components/ui/SoundToggle.astro';
import ContactModal from '../components/sections/ContactModal.astro';
import PageTransition from '../components/layout/PageTransition.astro';
// noindex: pages search engines should skip (404)
// contact={false}: no contact popup (the contact page itself, the no-JS fallback that holds the same form)
// theme: the page's first theme (the project pages are dark: Oct 2026); the scroll theme takes over on mount
interface Props { title?: string; description?: string; noindex?: boolean; contact?: boolean; theme?: 'light' | 'dark' }
const { title = meta.title, description = meta.description, noindex = false, contact = true, theme = pageTheme.base } = Astro.props;
// structured data: who this site is about (search engines)
const person = { '@context': 'https://schema.org', '@type': 'Person', name: nav.name, jobTitle: nav.role, url: Astro.site?.href, email: `mailto:${meta.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Ghent', addressCountry: 'BE' }, sameAs: socials.map((s) => s.href) };
// without a trailing slash, like the site's own links and the sitemap (/about, not /about/)
// without the .html of the build's file format and without a trailing slash, as the links and the sitemap
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1'), Astro.site);
const image = new URL(meta.image, Astro.site);
// Google Analytics (GA4, the gtag.js tag straight from Google, no Tag Manager): production builds only (`live`), and it
// only loads once the visitor allows analytics in the cookie banner (vanilla-cookieconsent runs scripts with
// type="text/plain" data-category="analytics" on consent: the tag is injected from there, never pasted as is, which
// would load it before any consent). Consent mode v2 defaults are set first (everything denied), and
// global/cookieConsent.js updates them with the visitor's choice. Page swaps send their own page_view (main.js).
const GA = 'G-DHBL6P1E1P';
// production builds only (NODE_ENV: import.meta.env in this file trips Vite's dev transform)
const live = process.env.NODE_ENV === 'production';
// as strings (set:html): braces written straight inside a conditional script tag would be read as template expressions (and never write the tag itself in a comment here: dev reads it as a script)
const consentDefaults = "window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',wait_for_update:500});";
const gaSnippet = "(function(){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=" + GA + "';document.head.appendChild(s)})();window.__ga='" + GA + "';gtag('js',new Date());gtag('config','" + GA + "');";
---
<!doctype html>
<html lang="en" class="no-js" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {live && <script is:inline set:html={consentDefaults} />}
    {live && <script is:inline type="text/plain" data-category="analytics" set:html={gaSnippet} />}
    <!-- theme (scripts/global/theme.js): light (dark sections are set per section), or the hidden "wild" one if it was found in this visit, set before the first paint -->
    <script is:inline>document.documentElement.classList.remove('no-js');try{if(sessionStorage.getItem('wild'))document.documentElement.dataset.theme='wild';const F={white:'#ffffff',paper:'#e8e1d9',grey:'#bdb5ae',charcoal:'#3a322e',ink:'#0e0907'},q=new URLSearchParams(location.search).get('field');if(q)sessionStorage.setItem('field',q);const f=F[sessionStorage.getItem('field')];if(f)document.documentElement.style.setProperty('--thumb-field',f)}catch(e){}</script>
    <!-- page loader: shown until scripts/global/pageTransitions.js has played it (safety net: gone after 8 s regardless);
         once per visit (a reload or a link opened in the same tab later skips it) -->
    <script is:inline>let seen;try{seen=sessionStorage.getItem('loaded')}catch(e){}if(!seen&&!matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.classList.add('is-loading');setTimeout(()=>document.documentElement.classList.remove('is-loading'),8000)}</script>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <!-- social previews (LinkedIn, Slack, X, ...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Robbe Van Aken" />
    <meta property="og:locale" content="en" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The blackletter R of Robbe Van Aken" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <!-- favicons: .ico for older browsers, SVG for modern ones, PNG for the iOS home screen, manifest for Android -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={theme === "dark" ? "#150d0a" : "#f3eee8"} />
    <!-- self-hosted Inter Tight (styles/base/_fonts.css): preload the two files every page needs -->
    <link rel="preload" href="/fonts/inter-tight-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="c-skip-link u-text-ui" href="#top" data-skip-link>Skip to content</a>
    <!-- swup swaps (and fades) everything inside #swup -->
    <div id="swup">
      <slot />
    </div>
    <PageTransition />
    <!-- album of the week, fixed bottom left (outside #swup too) -->
    <Music />
    <!-- the sound tile, fixed bottom right (outside #swup too) -->
    <SoundToggle />
    <!-- the contact popup (outside #swup: it survives page swaps, a half-filled form too) -->
    {contact && <ContactModal />}
    <!-- the paper grain over everything (_grain.css) -->
    <div class="c-grain" aria-hidden="true"></div>
    <script>
      import '../scripts/main.js';
    </script>
</body>
</html>
