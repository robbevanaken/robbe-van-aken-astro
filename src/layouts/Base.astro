---
import '../styles/global.css';
import { meta } from '../data/site';
interface Props { title?: string; description?: string }
const { title = meta.title, description = meta.description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/R.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <script>
      import { initCookieConsent } from '../scripts/cookie-consent.js';
      initCookieConsent();
    </script>
  </body>
</html>
