---
// HTML shell for every page: styles, font preloads and the single script entry (scripts/main.js).
import '../styles/main.css';
import { meta } from '../data/site';
interface Props { title?: string; description?: string }
const { title = meta.title, description = meta.description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/R.svg" type="image/svg+xml" />
    <!-- self-hosted Inter Tight (styles/base/_fonts.css): preload the two files every page needs -->
    <link rel="preload" href="/fonts/inter-tight-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
