---
// Layout for subpages: header (with the small animated R centred in it), content, footer (with its own big R).
// footer={false} for pages that end in their own full-screen section (project detail: scroll to next project).
import Base from './Base.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import GridOverlay from '../components/layout/GridOverlay.astro';
interface Props { title: string; description?: string; footer?: boolean; noindex?: boolean; theme?: 'dark' | 'light' }
const { title, description, footer = true, noindex = false, theme = 'dark' } = Astro.props;
---
<Base title={`${title} · Robbe Van Aken`} description={description} noindex={noindex} theme={theme}>
  <!-- two separate R's on subpages: a small one in the header (also the R in the page loader: data-r-intro) and a big one in the footer -->
  <canvas class="c-r-canvas" aria-hidden="true" data-r-canvas data-r-scope="[data-site-header]" data-r-intro></canvas>
  {footer && <canvas class="c-r-canvas" aria-hidden="true" data-r-canvas data-r-scope="[data-site-footer]"></canvas>}
  <Nav withR />
  <main id="top" tabindex="-1" class:list={['c-page', { 'c-page--end': !footer }]}>
    <slot />
  </main>
  {footer && <Footer />}
  {import.meta.env.DEV && <GridOverlay />}
</Base>
