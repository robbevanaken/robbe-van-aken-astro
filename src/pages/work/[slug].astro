---
// Project detail page. Empty for now: caption, title, the placeholder visual and a link to the next project.
import Page from '../../layouts/Page.astro';
import PageIntro from '../../components/sections/PageIntro.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import ScrollNext from '../../components/sections/ScrollNext.astro';
import { projects, type Project } from '../../data/projects';
import { projectPage } from '../../data/pages';

export function getStaticPaths() {
  return projects.map((project, i) => ({ params: { slug: project.slug }, props: { project, index: i } }));
}
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const next = projects[(index + 1) % projects.length];
const pad = (n: number) => String(n).padStart(2, '0');
---
<Page title={project.title} description={project.description} footer={false}>
  <PageIntro label={`${pad(index + 1)} — ${project.title}`} title={project.title} intro={project.description} />
  <div class="visual grid">
    {project.image
      ? <img src={project.image} alt="" />
      : <div class="placeholder" style={`--a:${project.colors.a};--b:${project.colors.b};--t:${project.colors.t}`}>{project.label}</div>}
  </div>
  <Placeholder text={projectPage.placeholder} />
  <div class="back grid"><a class="t-ui" href="/work">{projectPage.back}</a></div>
  <ScrollNext project={next} label={projectPage.next} />
</Page>

<style>
  .visual{margin-top:var(--space-xl)}
  .visual > *{grid-column:1 / -1;aspect-ratio:16 / 9;width:100%;object-fit:cover}
  .placeholder{display:grid;place-items:center;font-size:clamp(28px,4.4vw,72px);letter-spacing:-.03em;color:var(--t);
    background:radial-gradient(90% 70% at 72% 18%,var(--b) 0,transparent 62%),linear-gradient(160deg,var(--a),#000 140%)}
  .back{margin-top:var(--space-l)}
  .back a{grid-column:1 / span 3;color:var(--muted);text-decoration:none;transition:color var(--hover-dur) var(--ease-punch)}
  .back a:hover{color:var(--fg)}
</style>
