---
// Project detail page: a meta line, the title + the context as one statement, the main visual, the case study
// (sections/ProjectCase.astro), the back button ("All projects"), then "scroll to next project".
// Styles: styles/components/_project-detail.css
import Page from '../../layouts/Page.astro';
import PageIntro from '../../components/sections/PageIntro.astro';
import Button from '../../components/ui/Button.astro';
import ProjectVisual from '../../components/ui/ProjectVisual.astro';
import ScrollNext from '../../components/sections/ScrollNext.astro';
import ProjectCase from '../../components/sections/ProjectCase.astro';
import { projects, type Project } from '../../data/projects';
import { projectPage } from '../../data/pages';

export function getStaticPaths() {
  return projects.map((project, i) => ({ params: { slug: project.slug }, props: { project, index: i } }));
}
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const nextIndex = (index + 1) % projects.length, next = projects[nextIndex];
const pad = (n: number) => String(n).padStart(2, '0');
---
<Page title={project.title} description={project.description} footer={false} dark>
  <!-- the opening (after naughtyduk.com's project pages): a meta line (number, service, year), then the title and the
       context as one two-tone statement (the title in the grey, like the footer's title), then the main visual -->
  <PageIntro title={project.title} intro={project.story?.intro ?? project.description} modifier="case">
    <p class="c-page-intro__meta u-text-label u-text-muted"><span>{pad(index + 1)} / {pad(projects.length)}</span><span data-page-intro-service>{project.service}</span><span data-page-intro-year>{project.year}</span></p>
  </PageIntro>
  <div class="c-project-detail__visual o-container o-grid" data-project-visual>
    {project.shot || project.image
      ? <ProjectVisual class="c-project-detail__media" project={project} alt={`${project.title}: ${project.description}`} eager data-project-media />
      : <div class="c-project-detail__media c-project-detail__placeholder" data-project-media style={`--a:${project.colors.a};--b:${project.colors.b};--t:${project.colors.t}`}>{project.label}</div>}
  </div>
  {project.story
    ? <ProjectCase project={project}><Button slot="end" back href="/#work">{projectPage.back}</Button></ProjectCase>
    : <div class="c-project-detail__back o-container o-grid" data-scroll-next-fade><Button back class="c-project-detail__back-link" href="/#work">{projectPage.back}</Button></div>}
  <ScrollNext project={next} label={projectPage.next} />
</Page>
