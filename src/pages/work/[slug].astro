---
// Project detail page. Empty for now: caption, title, the placeholder visual, then "scroll to next project".
// Styles: styles/components/_project-detail.css
import Page from '../../layouts/Page.astro';
import PageIntro from '../../components/sections/PageIntro.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import ScrollNext from '../../components/sections/ScrollNext.astro';
import { projects, type Project } from '../../data/projects';
import { projectPage } from '../../data/pages';

export function getStaticPaths() {
  return projects.map((project, i) => ({ params: { slug: project.slug }, props: { project, index: i } }));
}
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const nextIndex = (index + 1) % projects.length, next = projects[nextIndex];
const pad = (n: number) => String(n).padStart(2, '0');
---
<Page title={project.title} description={project.description} footer={false}>
  <PageIntro label={`${pad(index + 1)} — ${project.title}`} title={project.title} intro={project.description} />
  <div class="c-project-detail__visual o-container o-grid" data-project-visual>
    {project.image
      ? <img class="c-project-detail__media" src={project.image} alt="" data-project-media />
      : <div class="c-project-detail__media c-project-detail__placeholder" data-project-media style={`--a:${project.colors.a};--b:${project.colors.b};--t:${project.colors.t}`}>{project.label}</div>}
  </div>
  <Placeholder text={projectPage.placeholder} />
  <div class="c-project-detail__back o-container o-grid"><a class="c-project-detail__back-link u-text-ui" href="/work">{projectPage.back}</a></div>
  <ScrollNext project={next} label={projectPage.next} pageLabel={`${pad(nextIndex + 1)} — ${next.title}`} />
</Page>
