---
// /work: all projects. Styles: styles/components/_project-list.css
import Page from '../../layouts/Page.astro';
import PageIntro from '../../components/sections/PageIntro.astro';
import Icon from '../../components/ui/Icon.astro';
import { workPage as p } from '../../data/pages';
import { projects } from '../../data/projects';
const pad = (n: number) => String(n).padStart(2, '0');
---
<Page title="Work">
  <PageIntro label={p.label} title={p.title} intro={p.intro} />
  <ul class="c-project-list o-container o-grid">
    {projects.map((pr, i) => (
      <li class="c-project-list__item">
        <a class="c-project-list__row" href={`/work/${pr.slug}`}>
          <span class="c-project-list__num u-text-label">{pad(i + 1)}</span>
          <span class="c-project-list__name u-text-lead">{pr.title}</span>
          <span class="c-project-list__desc u-text-body-l">{pr.description}</span>
          <span class="c-project-list__go"><Icon name="arrow" /></span>
        </a>
      </li>
    ))}
  </ul>
</Page>
