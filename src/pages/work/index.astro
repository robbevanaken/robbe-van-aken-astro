---
// /work: the page intro, then all projects on the globe in a grid, two per row (sections/ProjectGlobe.astro, as on home
// but without the corner brackets).
import Page from '../../layouts/Page.astro';
import PageIntro from '../../components/sections/PageIntro.astro';
import ProjectGlobe from '../../components/sections/ProjectGlobe.astro';
import { workPage as p } from '../../data/pages';
import { projects } from '../../data/projects';
---
<Page title="Work">
  <PageIntro label={p.label} title={p.title} intro={p.intro} />
  <ProjectGlobe projects={projects} label={p.title} layout="grid" />
</Page>
