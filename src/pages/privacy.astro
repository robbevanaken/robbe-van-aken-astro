---
// Privacy notice: the page intro, then the text (sections/Legal.astro). Copy: privacyPage in src/data/pages.ts.
import Page from '../layouts/Page.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import Legal from '../components/sections/Legal.astro';
import { privacyPage as p } from '../data/pages';
---
<Page title={p.title} description={p.description}>
  <PageIntro title={p.title} intro={p.intro} />
  <Legal updated={p.updated} company={p.company} sections={p.sections} />
</Page>
