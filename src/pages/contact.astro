---
import Page from '../layouts/Page.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import { contactPage as p } from '../data/pages';
import { meta } from '../data/site';
---
<Page title="Contact">
  <PageIntro label={p.label} title={p.title} intro={p.intro}>
    <a class="c-link-mail u-text-lead" href={`mailto:${meta.email}`}>{meta.email}</a>
  </PageIntro>
</Page>
