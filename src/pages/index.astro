---
// Home. Page order below; copy lives in src/data/, scripts start from src/scripts/main.js.
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import DevHud from '../components/layout/DevHud.astro';
import GridOverlay from '../components/layout/GridOverlay.astro';
import Marquee from '../components/ui/Marquee.astro';
import Hero from '../components/sections/Hero.astro';
import TrustedBy from '../components/sections/TrustedBy.astro';
import Pitch from '../components/sections/Pitch.astro';
import Projects from '../components/sections/Projects.astro';
import Services from '../components/sections/Services.astro';
import Footer from '../components/sections/Footer.astro';
---
<Base>
  <canvas id="r-canvas" class="c-r-canvas" aria-hidden="true" data-r-canvas></canvas>
  <Nav />
  <main id="top">
    <Hero />
    <Marquee />
    <TrustedBy />
    <Pitch />
    <Projects />
    <Services />
  </main>
  <Footer />
  {import.meta.env.DEV && <><DevHud /><GridOverlay /></>}
</Base>
